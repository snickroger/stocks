{
  "name": "nrogers-stocks",
  "version": "1.0.0",
  "description": "Scared money don't make money",
  "scripts": {
    "prestart": "npm run build",
    "start": "node ./dist/app.js",
    "watch": "tsc -w",
    "debug": "nodemon --legacy-watch --watch ./dist --inspect-brk=0.0.0.0:9229 --nolazy ./dist/app.js",
    "build": "npm install && npx tsc --build . --verbose",
    "lint": "npx eslint ./src",
    "lint-fix": "npx eslint --fix ./src"
  },
  "type": "module",
  "author": "Nick Rogers",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "eslint": "^10.3.0",
    "google-auth-library": "^11.3.1",
    "googleapis": "^188.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
